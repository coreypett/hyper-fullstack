<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Fullstack" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@color/launch_background</item>
        <item name="android:colorAccent">#FF8A2A</item>
        <item name="android:navigationBarColor">@color/launch_background</item>
        <item name="android:statusBarColor">@color/launch_background</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.Fullstack.Launch" parent="Theme.Fullstack">
        <item name="android:windowBackground">@drawable/launch_screen</item>
    </style>
</resources>
