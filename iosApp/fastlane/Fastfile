default_platform(:ios)

require "dotenv"

repo_root = File.expand_path("../..", __dir__)
Dotenv.overload(File.join(repo_root, "iosApp", ".env"))

ios_project = File.join(repo_root, "iosApp", "hyper-fullstack.xcodeproj")
derived_data_path = File.join(repo_root, "build", "xcode-derived")

def app_store_api_key
  app_store_connect_api_key(
    key_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_ID"),
    issuer_id: ENV.fetch("APP_STORE_CONNECT_API_ISSUER_ID"),
    key_filepath: ENV.fetch("APP_STORE_CONNECT_API_KEY_FILEPATH"),
    duration: 1200,
    in_house: false
  )
end

def skip_set_partition_list
  ENV.fetch("MATCH_SKIP_SET_PARTITION_LIST", "true") == "true"
end

platform :ios do
  desc "Install development signing assets managed by fastlane match"
  lane :sync_development_signing do
    match(
      type: "development",
      api_key: app_store_api_key,
      skip_set_partition_list: skip_set_partition_list
    )
  end

  desc "Install App Store/TestFlight signing assets managed by fastlane match"
  lane :sync_appstore_signing do
    match(
      type: "appstore",
      api_key: app_store_api_key,
      skip_set_partition_list: skip_set_partition_list
    )
  end

  desc "Generate the Tuist project and build an unsigned simulator app"
  lane :build_simulator do
    sh("cd #{repo_root}/iosApp && tuist generate --no-open")
    sh([
      "xcodebuild",
      "-project #{ios_project}",
      "-scheme iosApp",
      "-configuration Debug",
      "-sdk iphonesimulator",
      "-destination 'generic/platform=iOS Simulator'",
      "-derivedDataPath #{derived_data_path}",
      "CODE_SIGNING_ALLOWED=NO",
      "build",
    ].join(" "))
  end

  desc "Build a TestFlight-ready archive using fastlane match App Store signing"
  lane :build_testflight do
    sync_appstore_signing
    sh("cd #{repo_root}/iosApp && tuist generate --no-open")

    gym(
      project: ios_project,
      scheme: "iosApp",
      configuration: "Release",
      export_method: "app-store",
      output_directory: File.join(repo_root, "build", "ios"),
      output_name: "hyper-fullstack",
      derived_data_path: derived_data_path,
      xcargs: [
        "DEVELOPMENT_TEAM=#{ENV.fetch("FASTLANE_TEAM_ID")}",
      ].join(" "),
      export_options: {
        provisioningProfiles: {
          ENV.fetch("APP_IDENTIFIER", "org.coreypett.fullstack") => "match AppStore #{ENV.fetch("APP_IDENTIFIER", "org.coreypett.fullstack")}",
        },
      },
    )
  end

  desc "Upload the latest TestFlight archive to App Store Connect"
  lane :upload_testflight do
    upload_to_testflight(
      api_key: app_store_api_key,
      ipa: File.join(repo_root, "build", "ios", "hyper-fullstack.ipa"),
      skip_waiting_for_build_processing: true
    )
  end
end
